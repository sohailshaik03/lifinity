# Example env for production
# Set `DATABASE_URL` to a Postgres connection string when deploying to cloud
DATABASE_URL=postgresql://username:password@hostname:5432/retailsight_production

# Local dev fallback (optional)
# DB_URL_SQLITE=sqlite:///retailsight_dev.db

ENV=development
LOG_LEVEL=INFO# Environment configuration for Retailsights
# Copy this file to .env and fill in the actual values

# Database configuration

DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=lifinity

# Application environment
ENV=development

# Logging level
LOG_LEVEL=INFO
